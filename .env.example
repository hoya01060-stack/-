# 텔레그램 (필수) - @BotFather 에서 봇 생성 후 토큰, 본인 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 한국투자증권 Open API (장중 실시간 시세용, 권장) - 없으면 yfinance(지연 시세)로 대체
KIS_APP_KEY=
KIS_APP_SECRET=
# real(실전) 또는 paper(모의)
KIS_ENV=real

# DART Open API (국내 사이클주 재무데이터, 선택) - https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# Claude API (브리핑 해설문 생성, 선택) - 없으면 수치 브리핑만 발송
ANTHROPIC_API_KEY=
